# Upstream Manager connections. Copy to .env (beside this file, or into data/) and fill in what you use.
# Real environment variables win over this file; what you save in Settings wins over both.
# Point somewhere else with UPSTREAM_ENV_FILE=/path/to/file.

# --- This app ---------------------------------------------------------------
PORT=5001                              # 5001 is where Hermes Studio's Upstream tab looks
HOST=127.0.0.1
# How agents and other apps reach this app (used in the setup commands and given to agents)
UPSTREAM_APP_URL=http://127.0.0.1:5001
# Extra host names the web UI may be opened under (IP addresses and localhost always work)
# UPSTREAM_ALLOWED_HOSTS=upstream.lan,homelab
# Hermes Studio's Upstream tab forwards to this app. From the same machine that just works; if Studio
# runs in a container, list the address it calls from (and set HOST=0.0.0.0 or the docker bridge address):
# UPSTREAM_TRUSTED_PROXIES=172.17.0.0/16

# Agents with this app's tools may hand tasks to herdr, Studio or Hermes (at most five at once): on / off
# UPSTREAM_AGENT_DISPATCH=on

# --- Your files ---------------------------------------------------------------
# One folder holds both: <UPSTREAM_HOME>/Repos (repos you clone here) and <UPSTREAM_HOME>/References
# (the reference library). Either can live elsewhere on its own. Settings can still move the library.
UPSTREAM_HOME=/home/me/ManagerFiles
# UPSTREAM_REPOS_DIR=/home/me/ManagerFiles/Repos
# UPSTREAM_REFERENCES_DIR=/home/me/ManagerFiles/References
# UPSTREAM_REFS_UPDATE_HOURS=24        # reference repos update themselves this often (0 = never)

# --- herdr (coding agents) ---------------------------------------------------
# Same machine: nothing to set. herdr is used as soon as its socket exists
# (~/.config/herdr/herdr.sock). Force it with on / off:
# UPSTREAM_HERDR=on
# HERDR_SOCKET_PATH=/home/me/.config/herdr/herdr.sock
# HERDR_SESSION=agents                 # a named herdr session instead of the default
UPSTREAM_HERDR_KIND=hermes             # agent to start for a task: hermes, claude, codex, opencode, ...
# Other machine: herdr reaches it itself (set it up once with: herdr machine add <ssh-host>).
# UPSTREAM_HERDR_MACHINE=workbox       # send tasks to that machine's herdr by default
# UPSTREAM_HERDR_PATH_MAP=/home/me/repos=/srv/repos   # where this machine's folders are over there
# UPSTREAM_HERDR_BIN=/usr/local/bin/herdr

# --- Hermes Studio (address + sign-in) ---------------------------------------
# Same machine: nothing to set. Open Upstream once in Studio's Upstream tab and Studio hands over
# its address and a login (renewed on its own). Set these only to connect without that, or elsewhere:
# HERMES_STUDIO_URL=http://127.0.0.1:8648
# UPSTREAM_STUDIO_TOKEN=               # a Studio token; or let it sign in:
# HERMES_STUDIO_USER=
# HERMES_STUDIO_PASSWORD=
# HERMES_STUDIO_AGENT=                 # empty = Hermes; or claude-code, codex, opencode
# herdr agents on Studio's machine start through Studio, as Studio chats: auto (when Studio's herdr
# is connected) / on / off (always use Upstream's own herdr connection)
# UPSTREAM_HERDR_VIA_STUDIO=auto

# --- Hermes API server (address + key) ---------------------------------------
# HERMES_API_URL=http://127.0.0.1:8642
# HERMES_API_KEY=                      # Hermes' API_SERVER_KEY

# --- Pondering Orb (address + token) -----------------------------------------
# ORB_URL=http://127.0.0.1:8095
# UPSTREAM_ORB_TOKEN=
# ORB_TASK_LIST=Inbox

# --- LLM wiki (address + key) ------------------------------------------------
# LLMWIKI_MCP_URL=http://127.0.0.1:27123/mcp
# LLMWIKI_API_KEY=

# --- Integrations page: your other containers and how far each repo is integrated ---
# name=address (a path on it is the health check; tcp:// only checks the port) @repo it is built from
# UPSTREAM_SERVICES=firefly=http://127.0.0.1:8080/health@firefly-iii, db=tcp://127.0.0.1:5432
# repo: integrated / partial / planned / none (a mark set on the page wins)
# UPSTREAM_MARKS=coinpile:planned, plaid-firefly-connector:partial

# --- Coding agents on other machines: the MCP tools over HTTP (http://<host>:<port>/mcp) ---
# UPSTREAM_MCP_PORT=5002
# UPSTREAM_MCP_HOST=0.0.0.0           # default 127.0.0.1 (this machine only)
# UPSTREAM_MCP_TOKEN=                 # required when the host is not 127.0.0.1; agents send it as a Bearer token

# --- Notifications (also on Settings -> Notifications) ---
# UPSTREAM_NTFY_URL=https://ntfy.sh/a-long-secret-topic
# UPSTREAM_NTFY_TOKEN=                # only for a protected topic
# UPSTREAM_GOTIFY_URL=https://gotify.example.com
# UPSTREAM_GOTIFY_TOKEN=              # a Gotify application token
# UPSTREAM_NOTIFY_WEBHOOK=            # JSON POST of each notification
# UPSTREAM_PUBLIC_URL=http://192.168.1.20:5001   # so notifications link back to the page

# --- The Overseer (ranks the board, makes tasks of problems, keeps agents going) ---
# UPSTREAM_OVERSEER_MINUTES=10        # 0 turns its loop off

# --- Merge workspaces ---
# UPSTREAM_MERGIRAF=off               # or the path to mergiraf (https://mergiraf.org); found on PATH by default

# --- Docker (docker compose up -d --build) -----------------------------------
# Docker mounts UPSTREAM_HOME (above) at the same path. Repos kept outside it: add REPOS_DIR too.
# REPOS_DIR=/home/me/repos             # optional: another folder of git repos (uncomment its line in docker-compose.yml)
# UPSTREAM_DATA_DIR=/home/me/.local/share/upstream-manager   # the app's data (default shown)
# UPSTREAM_UID=1000                    # your user and group ids (id -u, id -g), so files stay yours
# UPSTREAM_GID=1000

# --- Home forge (Forgejo or Gitea) ----------------------------------------------
# Your own Git forge, beside GitHub (README: "Home forge and mirrors"). The token
# needs write:repository, write:issue and read:user, and goes only to these hosts.
# UPSTREAM_FORGE_URL=http://192.168.20.5:3030
# UPSTREAM_FORGE_TOKEN=
# UPSTREAM_FORGE_HOSTS=forgejo:3000            # other addresses of the same forge
