[Unit]
Description=Upstream-Keep (upstream management web app)
Documentation=file:/home/codebox/workspace/uptrack-upkeep/README.md
After=network.target

[Service]
Type=simple
User=codebox
Group=codebox
WorkingDirectory=/home/codebox/workspace/uptrack-upkeep
Environment=PORT=5001
# The app listens on 127.0.0.1 by default (it has no login). Uncomment only if
# other machines must reach it directly rather than through a local proxy.
#Environment=HOST=0.0.0.0
Environment=PYTHONUNBUFFERED=1
# systemd's default PATH does not include ~/.local/bin, where uv lives.
Environment=PATH=/home/codebox/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/codebox/.local/bin/uv run --project /home/codebox/workspace/uptrack-upkeep python -m upstream_upkeep.run
Restart=on-failure
RestartSec=5

# NOTE: do NOT point ExecStart at daemonize_upkeep.py. That wrapper does a
# double-fork + setsid, which is exactly what systemd's Type=simple forbids:
# the tracked process would exit immediately and the unit would flap. systemd
# does the daemonising; the app must run in the foreground.

[Install]
WantedBy=multi-user.target
